<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Luciano Cotto — Brand · Motion · WebUI · AiDesign</title>
<link href="https://api.fontshare.com/v2/css?f[]=clash-display@300,400,500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollToPlugin.min.js"></script>
<style>
/* ===================== RESET & BASE ===================== */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --bg: #0a0a0a;
  --bg-alt: #111111;
  --bg-card: #161616;
  --bg-modal: #0d0d0d;
  --text: #f0f0f0;
  --text-muted: #888888;
  --text-dim: #555555;
  --accent: #00ff88;
  --accent-dim: #00cc6a;
  --accent-glow: rgba(0,255,136,0.12);
  --border: #222222;
  --border-light: #333333;
  --display: 'Clash Display', sans-serif;
  --mono: 'Space Mono', monospace;
  --nav-height: 60px;
}

html { scroll-behavior: auto; scrollbar-width: thin; scrollbar-color: var(--accent) var(--bg); }
body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; overflow-x: hidden; }
body::after {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 99998;
  opacity: 0.025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-repeat: repeat;
  background-size: 256px;
}
::selection { background: var(--accent); color: var(--bg); }
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--accent-dim); }
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }

/* ===================== NAVIGATION ===================== */
.nav {
  position: fixed; top: 0; left: 0; right: 0;
  height: var(--nav-height); z-index: 10000;
  background: rgba(10,10,10,0.88); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  border-bottom: 1px solid var(--border);
  transition: transform 0.4s cubic-bezier(0.22,1,0.36,1);
}
.nav--hidden { transform: translateY(-100%); }
.nav-inner { max-width: 1400px; margin: 0 auto; height: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; }
.nav-logo { font-family: var(--display); font-size: 16px; font-weight: 600; letter-spacing: 0.5px; display: flex; align-items: center; gap: 10px; }
.nav-logo::before { content: ''; width: 8px; height: 8px; background: var(--accent); display: inline-block; }
.nav-links { display: flex; gap: 0; list-style: none; }
.nav-links li a {
  font-family: var(--mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
  padding: 20px 16px; display: block; position: relative; color: var(--text-muted); transition: color 0.3s;
}
.nav-links li a:hover, .nav-links li a.active { color: var(--text); }
.nav-links li a.active::after { content: ''; position: absolute; bottom: 0; left: 16px; right: 16px; height: 2px; background: var(--accent); }
.nav-contact-btn {
  font-family: var(--mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
  color: var(--accent); border: 1px solid var(--accent); padding: 8px 20px;
  transition: all 0.3s; cursor: pointer; background: transparent;
}
.nav-contact-btn:hover { background: var(--accent); color: var(--bg); }
.nav-toggle { display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border: none; padding: 8px; }
.nav-toggle span { width: 24px; height: 2px; background: var(--text); transition: all 0.3s; display: block; }
.nav-toggle--open span:nth-child(1) { transform: rotate(45deg) translate(5px,5px); }
.nav-toggle--open span:nth-child(2) { opacity: 0; }
.nav-toggle--open span:nth-child(3) { transform: rotate(-45deg) translate(5px,-5px); }

.mobile-menu {
  display: none; position: fixed; inset: 0; background: var(--bg); z-index: 9999;
  flex-direction: column; align-items: center; justify-content: center; gap: 32px;
}
.mobile-menu--open { display: flex; }
.mobile-menu a { font-family: var(--display); font-size: 36px; font-weight: 600; color: var(--text); transition: color 0.3s; }
.mobile-menu a:hover { color: var(--accent); }

@media(max-width:768px) { .nav-links, .nav-contact-btn { display: none; } .nav-toggle { display: flex; } }

/* ===================== SECTION COMMON ===================== */
.section { min-height: 100vh; padding: calc(var(--nav-height) + 60px) 24px 60px; max-width: 1400px; margin: 0 auto; }
.section-header { margin-bottom: 60px; }
.section-label {
  font-family: var(--mono); font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
  color: var(--accent); margin-bottom: 16px; display: flex; align-items: center; gap: 12px;
}
.section-label::before { content: ''; width: 40px; height: 1px; background: var(--accent); }
.section-title {
  font-family: var(--display); font-size: clamp(36px, 6vw, 72px); font-weight: 600;
  line-height: 1.05; letter-spacing: -1px; max-width: 800px;
}
.section-subtitle { font-size: clamp(16px, 2vw, 20px); color: var(--text-muted); margin-top: 24px; max-width: 600px; line-height: 1.7; }
.section-grid-line { width: 100%; height: 1px; background: var(--border); margin: 40px 0; }

/* ===================== HERO ===================== */
.hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden; padding-top: var(--nav-height); }
.hero-bg-grid {
  position: absolute; inset: 0; pointer-events: none;
  background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 60px 60px; opacity: 0.3;
}
.hero-content { position: relative; z-index: 2; max-width: 1400px; margin: 0 auto; padding: 0 24px; width: 100%; }
.hero-eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: 6px; text-transform: uppercase; color: var(--accent); margin-bottom: 32px; display: flex; align-items: center; gap: 16px; }
.hero-eyebrow .line { width: 60px; height: 1px; background: var(--accent); }
.hero-headline { font-family: var(--display); font-size: clamp(40px, 8vw, 100px); font-weight: 600; line-height: 0.95; letter-spacing: -2px; margin-bottom: 32px; }
.hero-headline .accent-word { color: var(--accent); }
.hero-headline .outline-word { -webkit-text-stroke: 1.5px var(--text); color: transparent; }
.hero-sub { font-size: clamp(16px, 2vw, 20px); color: var(--text-muted); max-width: 560px; line-height: 1.7; margin-bottom: 48px; }
.hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }
.btn-primary {
  font-family: var(--mono); font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
  padding: 16px 36px; background: var(--accent); color: var(--bg); border: none;
  cursor: pointer; transition: all 0.3s; font-weight: 700;
}
.btn-primary:hover { background: var(--text); transform: translateY(-2px); }
.btn-secondary {
  font-family: var(--mono); font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
  padding: 16px 36px; background: transparent; color: var(--text); border: 1px solid var(--border-light);
  cursor: pointer; transition: all 0.3s;
}
.btn-secondary:hover { border-color: var(--text); transform: translateY(-2px); }

.hero-meta {
  position: absolute; bottom: 40px; left: 24px; right: 24px; max-width: 1400px; margin: 0 auto;
  display: flex; justify-content: space-between; align-items: flex-end;
}
.hero-stats { display: flex; gap: 48px; }
.hero-stat { display: flex; flex-direction: column; }
.hero-stat-number { font-family: var(--display); font-size: 40px; font-weight: 600; color: var(--text); }
.hero-stat-label { font-family: var(--mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); margin-top: 4px; }
.hero-scroll { font-family: var(--mono); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--text-dim); display: flex; align-items: center; gap: 12px; }
.hero-scroll .arrow { width: 1px; height: 40px; background: var(--text-dim); position: relative; animation: scrollPulse 2s ease-in-out infinite; }
@keyframes scrollPulse { 0%,100%{opacity:.3;transform:scaleY(.6);} 50%{opacity:1;transform:scaleY(1);} }

@media(max-width:768px) {
  .hero-stats { gap: 24px; }
  .hero-stat-number { font-size: 28px; }
}

/* ===================== MARQUEE ===================== */
.marquee-section { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); overflow: hidden; padding: 20px 0; }
.marquee-track { display: flex; width: max-content; animation: marqueeScroll 30s linear infinite; }
.marquee-item { font-family: var(--display); font-size: clamp(20px, 4vw, 48px); font-weight: 500; white-space: nowrap; padding: 0 32px; color: var(--text-dim); }
.marquee-item .sep { color: var(--accent); margin: 0 16px; }
@keyframes marqueeScroll { 0%{transform:translateX(0);} 100%{transform:translateX(-50%);} }

/* ===================== SPECIALTIES ===================== */
.specialties { padding: 0 24px 100px; max-width: 1400px; margin: 0 auto; }
.specialties-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); }
.specialty-card {
  background: var(--bg); padding: 40px 32px; position: relative; overflow: hidden; cursor: pointer;
  transition: all 0.5s cubic-bezier(0.22,1,0.36,1); min-height: 280px; display: flex; flex-direction: column; justify-content: space-between;
}
.specialty-card:hover { background: var(--bg-alt); }
.specialty-card::after {
  content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: var(--accent);
  transform: scaleX(0); transform-origin: left; transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
}
.specialty-card:hover::after { transform: scaleX(1); }
.specialty-number { font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
.specialty-icon { font-size: 40px; margin-bottom: 20px; opacity: 0.7; }
.specialty-name { font-family: var(--display); font-size: 28px; font-weight: 600; letter-spacing: -0.5px; margin-bottom: 12px; }
.specialty-desc { font-size: 14px; color: var(--text-muted); line-height: 1.6; }
.specialty-link-text {
  font-family: var(--mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
  color: var(--accent); margin-top: 24px; display: flex; align-items: center; gap: 8px; transition: gap 0.3s;
}
.specialty-card:hover .specialty-link-text { gap: 16px; }
@media(max-width:1024px) { .specialties-grid { grid-template-columns: repeat(2,1fr); } }
@media(max-width:600px) { .specialties-grid { grid-template-columns: 1fr; } }

/* ===================== FILTERS ===================== */
.projects-filter { display: flex; gap: 8px; margin-bottom: 40px; flex-wrap: wrap; }
.filter-btn {
  font-family: var(--mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
  padding: 8px 16px; background: transparent; color: var(--text-muted); border: 1px solid var(--border);
  cursor: pointer; transition: all 0.3s;
}
.filter-btn:hover, .filter-btn.active { color: var(--text); border-color: var(--accent); background: var(--accent-glow); }

/* ===================== BRAND GRID ===================== */
.brand-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; background: var(--border); }
.brand-item {
  background: var(--bg); aspect-ratio: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 32px; position: relative; overflow: hidden; cursor: pointer; transition: all 0.5s;
}
.brand-item:hover { background: var(--bg-alt); }
.brand-item-bg { position: absolute; inset: 0; opacity: 0.15; transition: opacity 0.5s; }
.brand-item:hover .brand-item-bg { opacity: 0.3; }
.brand-item-content { position: relative; z-index: 2; text-align: center; }
.brand-item-logo { width: 80px; height: 80px; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; }
.brand-item-logo svg { width: 100%; height: 100%; }
.brand-item-name { font-family: var(--display); font-size: 20px; font-weight: 600; margin-bottom: 4px; }
.brand-item-type { font-family: var(--mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); }
.brand-item-cta {
  font-family: var(--mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
  color: var(--accent); margin-top: 12px; opacity: 0; transform: translateY(8px); transition: all 0.4s;
}
.brand-item:hover .brand-item-cta { opacity: 1; transform: translateY(0); }
@media(max-width:768px) { .brand-grid { grid-template-columns: repeat(2,1fr); } }
@media(max-width:500px) { .brand-grid { grid-template-columns: 1fr; } }

/* ===================== MOTION GRID ===================== */
.reel-container {
  position: relative; width: 100%; aspect-ratio: 16/9; background: var(--bg-card);
  border: 1px solid var(--border); margin-bottom: 60px; overflow: hidden;
  display: flex; align-items: center; justify-content: center; cursor: pointer;
}
.reel-placeholder { text-align: center; }
.reel-play-btn {
  width: 80px; height: 80px; border: 2px solid var(--text); border-radius: 50%;
  display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;
  font-size: 28px; transition: all 0.3s; color: var(--text);
}
.reel-container:hover .reel-play-btn { background: var(--accent); border-color: var(--accent); transform: scale(1.1); }
.reel-title { font-family: var(--mono); font-size: 12px; letter-spacing: 4px; text-transform: uppercase; color: var(--text-muted); }

.motion-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
.motion-item {
  position: relative; overflow: hidden; cursor: pointer; border: 1px solid var(--border);
  background: var(--bg-card); transition: all 0.4s;
}
.motion-item:hover { border-color: var(--accent-dim); }
.motion-thumb { aspect-ratio: 16/10; overflow: hidden; position: relative; }
.motion-thumb svg { width: 100%; height: 100%; transition: transform 0.6s; }
.motion-item:hover .motion-thumb svg { transform: scale(1.08); }
.motion-play-icon {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%) scale(0.8);
  width: 48px; height: 48px; border: 2px solid rgba(255,255,255,0.8); border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 16px;
  color: white; opacity: 0; transition: all 0.4s; pointer-events: none;
}
.motion-item:hover .motion-play-icon { opacity: 1; transform: translate(-50%,-50%) scale(1); }
.motion-info { padding: 16px; }
.motion-title { font-family: var(--display); font-size: 15px; font-weight: 600; margin-bottom: 4px; }
.motion-meta { font-family: var(--mono); font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-dim); }
@media(max-width:768px) { .motion-grid { grid-template-columns: 1fr; } }

/* ===================== WebUI ===================== */
.webui-project {
  border: 1px solid var(--border); background: var(--bg-card); overflow: hidden;
  transition: all 0.5s; margin-bottom: 48px; cursor: pointer;
}
.webui-project:hover { border-color: var(--border-light); }
.webui-device { padding: 32px; background: var(--bg-alt); display: flex; justify-content: center; position: relative; }
.webui-mockup { width: 100%; max-width: 500px; border: 1px solid var(--border); overflow: hidden; }
.webui-mockup svg { width: 100%; display: block; }
.webui-details { padding: 32px; }
.webui-client { font-family: var(--mono); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
.webui-name { font-family: var(--display); font-size: 24px; font-weight: 600; letter-spacing: -0.5px; margin-bottom: 16px; }
.webui-brief { display: grid; grid-template-columns: auto 1fr; gap: 8px 20px; font-size: 14px; }
.webui-brief dt { font-family: var(--mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); padding-top: 2px; }
.webui-brief dd { color: var(--text-muted); line-height: 1.5; }
.webui-tech { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
.webui-tech span {
  font-family: var(--mono); font-size: 9px; letter-spacing: 1px; text-transform: uppercase;
  padding: 4px 10px; border: 1px solid var(--border); color: var(--text-dim);
}
.webui-cta-row { margin-top: 20px; display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); }
@media(max-width:900px) { .webui-showcase { grid-template-columns: 1fr; } }

/* ===================== AiDESIGN ===================== */
.ai-principles { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; background: var(--border); margin-bottom: 80px; }
.ai-principle { background: var(--bg); padding: 40px 32px; text-align: center; }
.ai-principle-icon { font-size: 32px; margin-bottom: 16px; }
.ai-principle-title { font-family: var(--display); font-size: 18px; font-weight: 600; margin-bottom: 8px; }
.ai-principle-desc { font-size: 14px; color: var(--text-muted); line-height: 1.6; }

.ai-workflow { display: flex; align-items: center; justify-content: center; gap: 0; margin-bottom: 80px; flex-wrap: wrap; }
.ai-step { text-align: center; padding: 24px 32px; }
.ai-step-number { font-family: var(--display); font-size: 48px; font-weight: 300; color: var(--border-light); margin-bottom: 8px; }
.ai-step-label { font-family: var(--display); font-size: 14px; font-weight: 600; }
.ai-step-sublabel { font-family: var(--mono); font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-dim); margin-top: 4px; }
.ai-connector { width: 40px; height: 2px; background: var(--border-light); flex-shrink: 0; }

.ai-quote { border: 1px solid var(--border); padding: 48px; margin: 60px 0; text-align: center; position: relative; }
.ai-quote::before {
  content: '"'; position: absolute; top: -10px; left: 32px;
  font-family: var(--display); font-size: 80px; font-weight: 300; color: var(--accent); line-height: 1;
}
.ai-quote-text { font-family: var(--display); font-size: clamp(18px, 2.5vw, 28px); font-weight: 400; line-height: 1.6; max-width: 700px; margin: 0 auto; }
.ai-quote-author { font-family: var(--mono); font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--text-dim); margin-top: 24px; }

.ai-gallery { display: grid; grid-template-columns: repeat(4,1fr); gap: 2px; background: var(--border); }
.ai-gallery-item { background: var(--bg); aspect-ratio: 1; overflow: hidden; cursor: pointer; position: relative; }
.ai-gallery-item svg { width: 100%; height: 100%; transition: transform 0.6s; }
.ai-gallery-item:hover svg { transform: scale(1.1); }
.ai-gallery-tag {
  position: absolute; bottom: 12px; left: 12px;
  font-family: var(--mono); font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
  padding: 4px 10px; background: rgba(10,10,10,0.85); color: var(--accent);
  opacity: 0; transform: translateY(8px); transition: all 0.4s;
}
.ai-gallery-item:hover .ai-gallery-tag { opacity: 1; transform: translateY(0); }

@media(max-width:900px) {
  .ai-principles { grid-template-columns: 1fr; }
  .ai-gallery { grid-template-columns: repeat(2,1fr); }
  .ai-workflow { flex-direction: column; }
  .ai-connector { width: 2px; height: 40px; }
}

/* ===================== CONTACT ===================== */
.contact-section { border-top: 1px solid var(--border); padding: 100px 24px; max-width: 1400px; margin: 0 auto; }
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
.contact-headline { font-family: var(--display); font-size: clamp(32px, 5vw, 64px); font-weight: 600; letter-spacing: -2px; line-height: 1.1; margin-bottom: 24px; }
.contact-sub { font-size: 18px; color: var(--text-muted); line-height: 1.7; margin-bottom: 40px; }
.contact-links { display: flex; flex-direction: column; gap: 24px; }
.contact-link { display: flex; align-items: center; gap: 16px; font-size: 16px; transition: color 0.3s; }
.contact-link:hover { color: var(--accent); }
.contact-link-icon {
  width: 48px; height: 48px; border: 1px solid var(--border); display: flex;
  align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; transition: all 0.3s;
}
.contact-link:hover .contact-link-icon { border-color: var(--accent); background: var(--accent-glow); }

.contact-form { display: flex; flex-direction: column; gap: 16px; }
.form-group { display: flex; flex-direction: column; gap: 6px; }
.form-group label { font-family: var(--mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); }
.form-group input, .form-group textarea {
  background: var(--bg-alt); border: 1px solid var(--border); padding: 14px 16px;
  font-family: inherit; font-size: 15px; color: var(--text); outline: none;
  transition: border-color 0.3s; resize: vertical;
}
.form-group input:focus, .form-group textarea:focus { border-color: var(--accent); }
.form-group textarea { min-height: 120px; }
.form-submit { align-self: flex-start; }
@media(max-width:900px) { .contact-grid { grid-template-columns: 1fr; gap: 60px; } }

/* ===================== FOOTER ===================== */
.footer { border-top: 1px solid var(--border); padding: 40px 24px; max-width: 1400px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
.footer-left { font-family: var(--mono); font-size: 11px; letter-spacing: 2px; color: var(--text-dim); }
.footer-right { display: flex; gap: 24px; }
.footer-right a { font-family: var(--mono); font-size: 11px; letter-spacing: 1px; color: var(--text-dim); transition: color 0.3s; }

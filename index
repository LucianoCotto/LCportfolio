  toggle.addEventListener('click',()=>{menuOpen=!menuOpen;toggle.classList.toggle('nav-toggle--open',menuOpen);mm.classList.toggle('mobile-menu--open',menuOpen);document.body.style.overflow=menuOpen?'hidden':'';});
  document.querySelectorAll('[data-mobile-link]').forEach(l=>{l.addEventListener('click',()=>{menuOpen=false;toggle.classList.remove('nav-toggle--open');mm.classList.remove('mobile-menu--open');document.body.style.overflow='';});});
  function updateActiveNav(){
    const sections=document.querySelectorAll('.hero[id],section[id]');
    const links=document.querySelectorAll('.nav-links a');
    let current='';
    sections.forEach(s=>{if(window.pageYOffset>=s.offsetTop-150)current=s.id;});
    links.forEach(l=>{l.classList.remove('active');if(l.dataset.section===current)l.classList.add('active');});
  }
  document.querySelectorAll('.nav-links a,.mobile-menu a,.specialty-card,a[href^="#"]:not(.nav-contact-btn)').forEach(link=>{
    if(link.closest('.nav-links')||link.closest('.mobile-menu')||link.classList.contains('specialty-card')){
      link.addEventListener('click',e=>{
        e.preventDefault();
        const t=document.querySelector(link.getAttribute('href')||'');
        if(t)gsap.to(window,{scrollTo:{y:t,offsetY:60},duration:1,ease:'power3.inOut'});
      });
    }
  });
  document.querySelectorAll('.nav-contact-btn').forEach(b=>{b.addEventListener('click',e=>{e.preventDefault();const t=document.querySelector('#contact');if(t)gsap.to(window,{scrollTo:{y:t,offsetY:60},duration:1,ease:'power3.inOut'});});});
})();

// ===================== GSAP ANIMATIONS =====================
function initAnimations(){
  gsap.registerPlugin(ScrollTrigger,ScrollToPlugin);

  // Hero
  gsap.from('.hero-eyebrow',{y:30,opacity:0,duration:0.8,ease:'power3.out',delay:0.2});
  gsap.from('.hero-headline .reveal-up',{y:80,opacity:0,duration:1,stagger:0.12,ease:'power3.out',delay:0.4});
  gsap.from('.hero-sub',{y:30,opacity:0,duration:0.8,ease:'power3.out',delay:1});
  gsap.from('.hero-ctas',{y:30,opacity:0,duration:0.8,ease:'power3.out',delay:1.2});
  gsap.from('.hero-stat',{y:30,opacity:0,duration:0.8,stagger:0.15,ease:'power3.out',delay:1.5});

  // Counters
  document.querySelectorAll('.counter').forEach(el=>{
    const t=parseInt(el.dataset.target);
    gsap.to(el,{duration:2,ease:'power1.out',delay:1.8,
      onUpdate:function(){const v=Math.round(this.progress()*t);el.textContent=v;}
    });
  });

  // Scroll reveals
  gsap.utils.toArray('.reveal-up,.reveal-scale,.reveal-right').forEach(el=>{
    if(el.closest('.hero'))return;
    const isRight=el.classList.contains('reveal-right');
    const isScale=el.classList.contains('reveal-scale');
    const props={};
    if(isRight)props.x=40;else if(isScale){props.scale=0.92;}else{props.y=40;}
    gsap.fromTo(el,props,{
      x:0,y:0,scale:1,opacity:1,duration:0.8,ease:'power3.out',
      scrollTrigger:{trigger:el,start:'top 85%',toggleActions:'play none none none'}
    });
  });

  // Parallax hero bg
  gsap.to('.hero-bg-grid',{y:-100,ease:'none',scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:true}});

  // Marquee speed
  const mt=document.querySelector('.marquee-track');
  ScrollTrigger.create({trigger:'.marquee-section',start:'top bottom',end:'bottom top',onUpdate:self=>{mt.style.animationDuration=Math.max(10,30-self.velocity/50)+'s';}});
}

// ===================== FILTER SYSTEM =====================
(function(){
  document.querySelectorAll('.projects-filter').forEach(fb=>{
    const btns=fb.querySelectorAll('.filter-btn');
    const section=fb.closest('.section');
    if(!section)return;
    // Find the grid after the filter bar
    const allGrids=section.querySelectorAll('.brand-grid,.motion-grid,.ai-gallery');
    let grid=allGrids[0];

    btns.forEach(btn=>{
      btn.addEventListener('click',()=>{
        btns.forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        const filter=btn.dataset.filter;
        // Find items
        let items;
        if(grid.classList.contains('brand-grid'))items=grid.querySelectorAll('.brand-item');
        else if(grid.classList.contains('motion-grid'))items=grid.querySelectorAll('.motion-item');
        else items=grid.querySelectorAll('.ai-gallery-item');

        items.forEach(item=>{
          const cat=item.dataset.category;
          if(filter==='all'||cat===filter){
            item.className=item.className.replace(/filter-\w+/g,'').trim();
            item.classList.add('filter-visible');
          }else{
            item.className=item.className.replace(/filter-\w+/g,'').trim();
            item.classList.add('filter-dimmed');
          }
        });
      });
    });
  });
})();

// ===================== POPUP MODAL SYSTEM =====================
(function(){
  const overlay=document.getElementById('popupOverlay');
  const container=document.getElementById('popupContainer');
  const closeBtn=document.getElementById('popupClose');
  const mediaArea=document.getElementById('popupMedia');
  const prevBtn=document.getElementById('popupPrev');
  const nextBtn=document.getElementById('popupNext');
  const counterEl=document.getElementById('popupCounter');
  const dotsEl=document.getElementById('popupDots');
  const catBadge=document.getElementById('popupCatBadge');
  const titleEl=document.getElementById('popupTitle');
  const captionEl=document.getElementById('popupCaption');
  const metaEl=document.getElementById('popupMeta');

  let currentSlide=0;
  let slides=[];
  let isVideoOnly=false;

  function createSlideHTML(slide,idx){
    const div=document.createElement('div');
    div.className='popup-slide'+(idx===0?' popup-slide--active':'');
    div.dataset.index=idx;

    if(slide.type==='iframe'){
      div.innerHTML=`<iframe src="${slide.src}" allow="autoplay;encrypted-media" allowfullscreen></iframe>`;
    }else if(slide.type==='video'){
      div.innerHTML=`<video src="${slide.src}" controls autoplay muted loop playsinline style="width:100%;height:100%;object-fit:contain;"></video>`;
    }else if(slide.type==='svg'||slide.type==='image'){
      div.innerHTML=`<img src="${slide.src}" alt="" style="width:100%;height:100%;object-fit:contain;">`;
    }
    return div;
  }

  function createVideoHTML(videoUrl){
    const wrap=document.createElement('div');
    wrap.className='popup-video-wrap';
    // Check if it's a YouTube/Vimeo embed URL
    if(videoUrl.includes('youtube')||videoUrl.includes('vimeo')){
      wrap.innerHTML=`<iframe src="${videoUrl}" allow="autoplay;encrypted-media" allowfullscreen style="width:100%;height:100%;"></iframe>`;
    }else{
      wrap.innerHTML=`<video src="${videoUrl}" controls autoplay muted loop playsinline style="width:100%;height:100%;object-fit:contain;"></video>`;
    }
    return wrap;
  }

  function openPopup(el){
    const type=el.dataset.popupType||'carousel';
    const title=el.dataset.popupTitle||'';
    const cat=el.dataset.popupCat||'';
    const caption=el.dataset.popupCaption||'';
    const meta=el.dataset.popupMeta||'';

    catBadge.textContent=cat;
    titleEl.textContent=title;
    captionEl.textContent=caption;
    metaEl.innerHTML='';
    if(meta){
      meta.split(',').forEach(m=>{
        const span=document.createElement('span');
        span.textContent=m.trim();
        metaEl.appendChild(span);
      });
    }

    // Clear previous media (keep buttons)
    const children=Array.from(mediaArea.children);
    children.forEach(c=>{
      if(!c.classList.contains('popup-carousel-btn')&&!c.classList.contains('popup-counter')&&!c.classList.contains('popup-dots')){
        c.remove();
      }
    });

    prevBtn.classList.add('hidden');
    nextBtn.classList.add('hidden');
    counterEl.classList.add('hidden');
    dotsEl.classList.add('hidden');
    dotsEl.innerHTML='';
    currentSlide=0;
    slides=[];

    if(type==='video'){
      isVideoOnly=true;
      const videoUrl=el.dataset.popupVideo||'';
      if(videoUrl){
        mediaArea.insertBefore(createVideoHTML(videoUrl),prevBtn);
      }else{
        const fallback=document.createElement('div');
        fallback.className='popup-video-wrap';
        fallback.innerHTML=`<div style="text-align:center;color:var(--text-muted);font-family:var(--mono);font-size:14px;"><div style="font-size:48px;margin-bottom:16px;">▶</div><div>Video no disponible</div></div>`;
        mediaArea.insertBefore(fallback,prevBtn);
      }
    }else{
      isVideoOnly=false;
      let slidesData=[];
      try{
        slidesData=JSON.parse(el.dataset.popupSlides||'[]');
      }catch(e){slidesData=[];}

      if(slidesData.length===0){
        const fb=document.createElement('div');
        fb.className='popup-video-wrap';
        fb.innerHTML=`<div style="text-align:center;color:var(--text-muted);font-family:var(--mono);font-size:14px;"><div style="font-size:48px;margin-bottom:16px;">🖼</div><div>Sin contenido disponible</div></div>`;
        mediaArea.insertBefore(fb,prevBtn);
      }else if(slidesData.length===1){
        // Single slide — no carousel controls needed
        slides=slidesData;
        mediaArea.insertBefore(createSlideHTML(slidesData[0],0),prevBtn);
      }else{
        slides=slidesData;
        slidesData.forEach((s,i)=>{
          mediaArea.insertBefore(createSlideHTML(s,i),prevBtn);
        });

        // Show controls
        prevBtn.classList.remove('hidden');
        nextBtn.classList.remove('hidden');
        counterEl.classList.remove('hidden');
        dotsEl.classList.remove('hidden');
        counterEl.textContent=`${slidesData.length} / ${slidesData.length}`;
        updateCounter();

        // Create dots
        slidesData.forEach((_,i)=>{
          const dot=document.createElement('button');
          dot.className='popup-dot'+(i===0?' popup-dot--active':'');
          dot.addEventListener('click',()=>goToSlide(i));
          dotsEl.appendChild(dot);
        });
      }
    }

    overlay.classList.add('popup-overlay--open');
    document.body.style.overflow='hidden';
  }

  function closePopup(){
    overlay.classList.remove('popup-overlay--open');
    document.body.style.overflow='';
    // Clean up videos
    mediaArea.querySelectorAll('video,iframe').forEach(m=>{
      try{m.pause();}catch(e){}
    });
  }

  function goToSlide(idx){
    if(idx<0||idx>=slides.length)return;
    const current=document.querySelector('.popup-slide--active');
    if(current)current.classList.remove('popup-slide--active');
    const nextSlide=document.querySelector(`.popup-slide[data-index="${idx}"]`);
    if(nextSlide)nextSlide.classList.add('popup-slide--active');
    currentSlide=idx;
    updateCounter();
    updateDots();
  }

  function updateCounter(){
    counterEl.textContent=`${currentSlide+1} / ${slides.length}`;
  }

  function updateDots(){
    const dots=dotsEl.querySelectorAll('.popup-dot');
    dots.forEach((d,i)=>{
      d.classList.toggle('popup-dot--active',i===currentSlide);
    });
  }

  prevBtn.addEventListener('click',()=>goToSlide(currentSlide-1));
  nextBtn.addEventListener('click',()=>goToSlide(currentSlide+1));
  closeBtn.addEventListener('click',closePopup);
  overlay.addEventListener('click',e=>{if(e.target===overlay)closePopup();});
  document.addEventListener('keydown',e=>{
    if(!overlay.classList.contains('popup-overlay--open'))return;
    if(e.key==='Escape')closePopup();
    if(e.key==='ArrowLeft'&&slides.length>1)goToSlide(currentSlide-1);
    if(e.key==='ArrowRight'&&slides.length>1)goToSlide(currentSlide+1);
  });

  // Touch swipe support
  let touchStartX=0;
  mediaArea.addEventListener('touchstart',e=>{touchStartX=e.touches[0].clientX;},{passive:true});
  mediaArea.addEventListener('touchend',e=>{
    const diff=touchStartX-e.changedTouches[0].clientX;
    if(Math.abs(diff)>50&&slides.length>1){
      if(diff>0)goToSlide(currentSlide+1);
      else goToSlide(currentSlide-1);
    }
  },{passive:true});

  // Bind all clickable items with data-popup-*
  document.querySelectorAll('[data-popup-type]').forEach(el=>{
    el.addEventListener('click',e=>{
      e.preventDefault();
      openPopup(el);
    });
  });
})();

// ===================== CONTACT FORM =====================
(function(){
  const form=document.getElementById('contactForm');
  form.addEventListener('submit',e=>{
    e.preventDefault();
    const fd=new FormData(form);
    const msg=encodeURIComponent(`Hola Luciano! 👋\n\n*Nombre:* ${fd.get('name')}\n*Email:* ${fd.get('email')}\n*Proyecto:* ${fd.get('project')}\n*Mensaje:* ${fd.get('message')}`);
    window.open(`https://wa.me/5491100000000?text=${msg}`,'_blank');
    const btn=form.querySelector('.btn-primary');
    const orig=btn.textContent;
    btn.textContent='✓ Enviado!';
    btn.style.background='#00cc6a';
    setTimeout(()=>{btn.textContent=orig;btn.style.background='';form.reset();},2000);
  });
})();
